# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/
.env/
*.egg-info/
dist/
build/

# Environment secrets (MUST NOT be committed)
.env

# Spotify OAuth token cache (contains access/refresh tokens)
.cache
.spotipy

# SQLite database files
database/*.sqlite
database/*.sqlite-wal
database/*.sqlite-shm

# MERT embedding files (large binary, regeneratable)
embeddings/**/*.npy

# User-specific local settings
cache/
!cache/settings.json
anchors/
local_music/
embeddings/

# Application logs and docs
logs/
*.log
docs/

# IDE and OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store
.stackdump