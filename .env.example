# How to get Spotify API key: https://developer.spotify.com/dashboard
#
# Important: Redirect URI must be 127.0.0.1, not localhost!
#        (Spotify prohibited localhost since Nov 2025)

SPOTIPY_CLIENT_ID=...
SPOTIPY_CLIENT_SECRET=...
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# your LLM
# which llm to use for selecting anchors: deepseek | ollama | mistral

LLM=deepseek

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b

DEEPSEEK_API_KEY=...
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optional: enables web-search-enriched track descriptions. Get a key at https://tavily.com
TAVILY_API_KEY=
# Caps Tavily API calls per description-generation batch. Set to 0 for
# unlimited (use with caution on free-tier accounts). Tracks beyond the
# cap still get audio-only descriptions — no data loss.
TAVILY_MAX_CALLS_PER_RUN=50

LOG_LEVEL=DEBUG
